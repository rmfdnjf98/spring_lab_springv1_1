<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springv1_1.board.BoardMapper">

    <select id="findAll" resultType="Board">
        select * from board_tb order by id desc
    </select>

    <select id="findById" resultType="Board" parameterType="int">
        select * from board_tb where id = #{id}
    </select>

    <insert id="save" parameterType="Board">
        insert into board_tb (title, content, create_at) values (#{title}, #{content}, now())
    </insert>

    <delete id="delete" parameterType="Board">
        DELETE FROM board_tb WHERE id = #{id}
    </delete>

    <update id="update" parameterType="Board">
        UPDATE board_tb
        SET title = #{title}, content = #{content}
        WHERE id = #{id}
    </update>

</mapper>
